{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/badugi",                "destination": "https://badugi-tutorial.vercel.app/badugi" },
    { "source": "/badugi/:path*",         "destination": "https://badugi-tutorial.vercel.app/badugi/:path*" },
    { "source": "/thai-music-ime",        "destination": "https://thai-music-ime.vercel.app/" },
    { "source": "/thai-music-ime/:path*", "destination": "https://thai-music-ime.vercel.app/:path*" },
    { "source": "/deuce-equity",          "destination": "https://deuce-equity.vercel.app/" },
    { "source": "/deuce-equity/:path*",   "destination": "https://deuce-equity.vercel.app/:path*" },
    { "source": "/cfr-simulation",        "destination": "/cfr-simulation.html" },
    { "source": "/cfr-simulation/:path*", "destination": "/:path*" }
  ]
}
